{
  "name": "mc-mod-utility",
  "displayName": "MC Mod Utility",
  "description": "Scaffold Minecraft mod projects and add components for Forge, Fabric, and NeoForge",
  "version": "0.3.5",
  "publisher": "MC-Mod-Utility",
  "repository": {
    "type": "git",
    "url": ""
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/mods.toml",
    "workspaceContains:**/neoforge.mods.toml",
    "workspaceContains:**/fabric.mod.json",
    "workspaceContains:**/build.gradle",
    "workspaceContains:**/build.gradle.kts",
    "workspaceContains:**/weapon_types/*.json",
    "workspaceContains:**/maw_saya/*.jsonc",
    "workspaceContains:**/.maw-addon.json"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mc-mod-utility.newProject",
        "title": "New Mod Project",
        "category": "MC Mod Utility",
        "shortTitle": "New Mod Project"
      },
      {
        "command": "mc-mod-utility.addComponent",
        "title": "Add Component",
        "category": "MC Mod Utility",
        "shortTitle": "Add Component"
      },
      {
        "command": "mc-mod-utility.rotationEditor",
        "title": "Rotation Editor",
        "category": "MC Mod Utility",
        "shortTitle": "Rotation Editor"
      },
      {
        "command": "mc-mod-utility.addRotationParams",
        "title": "Add @RotationParams",
        "category": "MC Mod Utility",
        "shortTitle": "Add @RotationParams"
      },
      {
        "command": "mc-mod-utility.themeColorEditor",
        "title": "Theme Color Editor",
        "category": "MC Mod Utility",
        "shortTitle": "Theme Color Editor"
      },
      {
        "command": "mc-mod-utility.mawWeaponStudio",
        "title": "MAW: 武器スタジオを開く",
        "category": "MC Mod Utility",
        "shortTitle": "武器スタジオ",
        "icon": "$(tools)"
      },
      {
        "command": "mc-mod-utility.newMawAddon",
        "title": "MAW: アドオンを新規作成",
        "category": "MC Mod Utility",
        "shortTitle": "MAW アドオン作成",
        "icon": "$(new-folder)"
      },
      {
        "command": "mc-mod-utility.mawInsertModel",
        "title": "MAW: 3Dモデルテンプレートを挿入",
        "category": "MC Mod Utility",
        "shortTitle": "3Dモデル",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "mc-mod-utility.mawRebrand",
        "title": "MAW: Mod ID を変更 (リブランド)",
        "category": "MC Mod Utility",
        "shortTitle": "リブランド"
      },
      {
        "command": "mc-mod-utility.mawRefresh",
        "title": "MAW: 情報を再読み込み",
        "category": "MC Mod Utility",
        "shortTitle": "再読み込み",
        "icon": "$(refresh)"
      },
      {
        "command": "mc-mod-utility.mawShowSource",
        "title": "MAW: 本体MODの読み込み元を表示",
        "category": "MC Mod Utility",
        "shortTitle": "本体MODの読み込み元",
        "icon": "$(info)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "mcModUtility.mawAddon",
          "name": "MAW アドオン",
          "when": "mcModUtility.isMawAddon"
        },
        {
          "type": "webview",
          "id": "mcModUtility.nyanCat",
          "name": "Nyan Cat",
          "icon": "$(heart)"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "mc-mod-utility.newProject",
          "when": "explorerResourceIsFolder",
          "group": "mcModUtility@1"
        },
        {
          "command": "mc-mod-utility.addComponent",
          "when": "explorerResourceIsFolder && mcModUtility.isModProject",
          "group": "mcModUtility@2"
        },
        {
          "command": "mc-mod-utility.rotationEditor",
          "when": "mcModUtility.isModProject",
          "group": "mcModUtility@3"
        },
        {
          "command": "mc-mod-utility.addRotationParams",
          "when": "!explorerResourceIsFolder",
          "group": "mcModUtility@4"
        },
        {
          "command": "mc-mod-utility.mawWeaponStudio",
          "when": "explorerResourceIsFolder && mcModUtility.isMawAddon",
          "group": "mcModUtility@5"
        },
        {
          "command": "mc-mod-utility.newMawAddon",
          "when": "explorerResourceIsFolder",
          "group": "mcModUtility@6"
        },
        {
          "command": "mc-mod-utility.mawInsertModel",
          "when": "explorerResourceIsFolder && mcModUtility.isMawAddon",
          "group": "mcModUtility@7"
        }
      ],
      "view/title": [
        {
          "command": "mc-mod-utility.mawWeaponStudio",
          "when": "view == mcModUtility.mawAddon",
          "group": "navigation@1"
        },
        {
          "command": "mc-mod-utility.mawInsertModel",
          "when": "view == mcModUtility.mawAddon",
          "group": "navigation@2"
        },
        {
          "command": "mc-mod-utility.mawRefresh",
          "when": "view == mcModUtility.mawAddon",
          "group": "navigation@3"
        },
        {
          "command": "mc-mod-utility.mawShowSource",
          "when": "view == mcModUtility.mawAddon",
          "group": "navigation@4"
        },
        {
          "command": "mc-mod-utility.mawRebrand",
          "when": "view == mcModUtility.mawAddon"
        }
      ],
      "editor/context": [
        {
          "command": "mc-mod-utility.addRotationParams",
          "when": "editorLangId == java || editorLangId == kotlin",
          "group": "mcModUtility@1"
        }
      ],
      "commandPalette": [
        {
          "command": "mc-mod-utility.newProject"
        },
        {
          "command": "mc-mod-utility.addComponent",
          "when": "mcModUtility.isModProject"
        },
        {
          "command": "mc-mod-utility.rotationEditor",
          "when": "mcModUtility.isModProject"
        },
        {
          "command": "mc-mod-utility.themeColorEditor"
        },
        {
          "command": "mc-mod-utility.mawWeaponStudio",
          "when": "mcModUtility.isMawAddon"
        },
        {
          "command": "mc-mod-utility.newMawAddon"
        },
        {
          "command": "mc-mod-utility.mawRebrand",
          "when": "mcModUtility.isMawAddon"
        },
        {
          "command": "mc-mod-utility.mawRefresh",
          "when": "mcModUtility.isMawAddon"
        },
        {
          "command": "mc-mod-utility.mawShowSource",
          "when": "mcModUtility.isMawAddon"
        },
        {
          "command": "mc-mod-utility.mawInsertModel",
          "when": "mcModUtility.isMawAddon"
        }
      ]
    },
    "configuration": {
      "title": "MC Mod Utility",
      "properties": {
        "mc-mod-utility.rotationEditor.searchPatterns": {
          "type": "array",
          "default": [
            "src/main/java/**/*.java",
            "src/main/kotlin/**/*.kt",
            "src/client/java/**/*.java",
            "src/client/kotlin/**/*.kt",
            "src/**/*.java",
            "src/**/*.kt"
          ],
          "description": "Glob patterns to search for @RotationParams blocks. Supports any mod loader (Forge, Fabric, NeoForge, Quilt)."
        },
        "mc-mod-utility.rotationEditor.excludePatterns": {
          "type": "string",
          "default": "**/build/**",
          "description": "Glob pattern to exclude from search."
        },
        "mc-mod-utility.rotationEditor.maxFiles": {
          "type": "number",
          "default": 200,
          "description": "Maximum number of files to scan."
        },
        "mc-mod-utility.rcon.host": {
          "type": "string",
          "default": "localhost",
          "description": "RCON server host"
        },
        "mc-mod-utility.rcon.port": {
          "type": "number",
          "default": 25575,
          "description": "RCON server port"
        },
        "mc-mod-utility.rcon.password": {
          "type": "string",
          "default": "minecraft",
          "description": "RCON server password"
        },
        "mc-mod-utility.maw.templatePath": {
          "type": "string",
          "default": "",
          "description": "MAW アドオンを新規作成するときに雛形として使うローカルプロジェクトのパス。空なら GitHub のテンプレートか、今開いているアドオンを使う。"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.39.3"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.5",
    "diff": ">=8.0.3"
  }
}
